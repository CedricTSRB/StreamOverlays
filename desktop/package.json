{
  "name": "tsrb-multichat",
  "version": "0.9.2",
  "private": true,
  "description": "Windows multi-platform live chat dashboard and local OBS source",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis-web --x64 --publish never",
    "start:obs": "node obs-server.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.tsrb.multichat",
    "productName": "TSRB MultiChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "style.css",
      "core.js",
      "connections.js",
      "package.json",
      "obs-server.js",
      "obs-dock.html",
      "obs-dock.js",
      "obs-dock.css",
      "obs-overlay.html",
      "obs-overlay.js",
      "obs-overlay.css"
    ],
    "win": {
      "target": [
        "nsis-web"
      ]
    },
    "nsisWeb": {
      "artifactName": "TSRB-MultiChat-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TSRB MultiChat",
      "runAfterFinish": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "CedricTSRB",
      "repo": "StreamOverlays",
      "vPrefixedTagName": true
    }
  },
  "dependencies": {
    "kick-live-connector": "*",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.2",
    "youtube-chat": "^2.2.0"
  }
}
