{
  "name": "tsrb-multichat",
  "version": "0.8.0",
  "private": true,
  "description": "Windows multi-platform live chat dashboard and local OBS source",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.tsrb.multichat",
    "productName": "TSRB MultiChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "style.css",
      "core.js",
      "connections.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "kick-live-connector": "*",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.2",
    "youtube-chat": "^2.2.0"
  }
}
